# NASA DONKI API key — obtain free at https://api.nasa.gov
# DEMO_KEY works for light testing but is rate-limited
NASA_API_KEY=

# IBM watsonx.ai credentials — server-side only, NEVER prefix with NEXT_PUBLIC_
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=

# NOAA SWPC requires no API key.

# ── Optional: local IBM Granite via Ollama ──────────────────────────────
# Leave ALL of these UNSET for the keyless default (grounded deterministic
# engine). Set them only to light up the "IBM Granite (local)" path on your
# own machine — e.g. to screen-record the full model demo. Runs card-free,
# no account, Apache-2.0 models. Not reachable from a hosted deploy.
#
# One-time (downloads ~11.6 GB total, you run these yourself):
#   ollama pull granite3.3:8b
#   ollama pull ibm/granite3.3-guardian:8b
#
# NARRATION_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=granite3.3:8b
# OLLAMA_GUARDIAN_MODEL=ibm/granite3.3-guardian:8b
# OLLAMA_TIMEOUT_MS=120000
